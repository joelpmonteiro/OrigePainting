---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Our Process" description="Learn about our systematic approach to delivering exceptional painting services">
	<!-- Hero Section -->
	<section class="bg-dark-secondary py-12 text-center border-b border-white/10">
		<div class="container mx-auto px-6">
			<h1 class="text-5xl md:text-6xl font-bold text-gold mb-4 tracking-tight">OUR PROCESS</h1>
			<div class="divider-gold"></div>
			<p class="text-xl text-white/70 mt-6 max-w-2xl mx-auto">
				A proven methodology that ensures excellence at every stage of your project
			</p>
		</div>
	</section>

	<!-- Detailed Process Steps -->
	<section class="bg-dark py-20">
		<div class="container mx-auto px-6">
			<div class="max-w-4xl mx-auto space-y-20">
				<!-- Step 1 -->
				<div class="flex flex-col md:flex-row gap-8 items-start">
					<div class="flex-shrink-0">
						<div class="icon-circle">
							<span class="text-3xl font-bold">1</span>
						</div>
					</div>
					<div class="flex-1">
						<h2 class="text-3xl font-bold text-gold mb-4 tracking-tight">CONSULTATION & ESTIMATE</h2>
						<p class="text-white/70 text-lg mb-6 leading-relaxed">
							Every successful project begins with understanding your vision. We start with a comprehensive consultation to discuss your goals, preferences, and budget.
						</p>
						<div class="grid md:grid-cols-2 gap-4">
							<div class="flex items-start gap-3">
								<svg class="w-6 h-6 text-gold mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
									<path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
								</svg>
								<span class="text-white/80">Free on-site evaluation</span>
							</div>
							<div class="flex items-start gap-3">
								<svg class="w-6 h-6 text-gold mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
									<path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
								</svg>
								<span class="text-white/80">Detailed project scope assessment</span>
							</div>
							<div class="flex items-start gap-3">
								<svg class="w-6 h-6 text-gold mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
									<path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
								</svg>
								<span class="text-white/80">Transparent, itemized pricing</span>
							</div>
							<div class="flex items-start gap-3">
								<svg class="w-6 h-6 text-gold mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
									<path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
								</svg>
								<span class="text-white/80">Color consultation and recommendations</span>
							</div>
						</div>
					</div>
				</div>

				<div class="h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent"></div>

				<!-- Step 2 -->
				<div class="flex flex-col md:flex-row gap-8 items-start">
					<div class="flex-shrink-0">
						<div class="icon-circle">
							<span class="text-3xl font-bold">2</span>
						</div>
					</div>
					<div class="flex-1">
						<h2 class="text-3xl font-bold text-gold mb-4 tracking-tight">SCHEDULING & PREPARATION</h2>
						<p class="text-white/70 text-lg mb-6 leading-relaxed">
							Once you approve the estimate, we schedule the project at your convenience and begin thorough surface preparation.
						</p>
						<div class="grid md:grid-cols-2 gap-4">
							<div class="flex items-start gap-3">
								<svg class="w-6 h-6 text-gold mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
									<path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
								</svg>
								<span class="text-white/80">Flexible scheduling to fit your timeline</span>
							</div>
							<div class="flex items-start gap-3">
								<svg class="w-6 h-6 text-gold mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
									<path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
								</svg>
								<span class="text-white/80">Furniture and fixture protection</span>
							</div>
							<div class="flex items-start gap-3">
								<svg class="w-6 h-6 text-gold mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
									<path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
								</svg>
								<span class="text-white/80">Surface cleaning and repairs</span>
							</div>
							<div class="flex items-start gap-3">
								<svg class="w-6 h-6 text-gold mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
									<path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
								</svg>
								<span class="text-white/80">Priming and sanding as needed</span>
							</div>
						</div>
					</div>
				</div>

				<div class="h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent"></div>

				<!-- Step 3 -->
				<div class="flex flex-col md:flex-row gap-8 items-start">
					<div class="flex-shrink-0">
						<div class="icon-circle">
							<span class="text-3xl font-bold">3</span>
						</div>
					</div>
					<div class="flex-1">
						<h2 class="text-3xl font-bold text-gold mb-4 tracking-tight">THE WORK</h2>
						<p class="text-white/70 text-lg mb-6 leading-relaxed">
							Our skilled craftsmen execute the painting with precision and care, using premium materials and proven techniques.
						</p>
						<div class="grid md:grid-cols-2 gap-4">
							<div class="flex items-start gap-3">
								<svg class="w-6 h-6 text-gold mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
									<path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
								</svg>
								<span class="text-white/80">Professional application techniques</span>
							</div>
							<div class="flex items-start gap-3">
								<svg class="w-6 h-6 text-gold mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
									<path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
								</svg>
								<span class="text-white/80">Multiple coats for durability</span>
							</div>
							<div class="flex items-start gap-3">
								<svg class="w-6 h-6 text-gold mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
									<path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
								</svg>
								<span class="text-white/80">Attention to detail and clean lines</span>
							</div>
							<div class="flex items-start gap-3">
								<svg class="w-6 h-6 text-gold mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
									<path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
								</svg>
								<span class="text-white/80">Daily progress updates</span>
							</div>
						</div>
					</div>
				</div>

				<div class="h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent"></div>

				<!-- Step 4 -->
				<div class="flex flex-col md:flex-row gap-8 items-start">
					<div class="flex-shrink-0">
						<div class="icon-circle">
							<span class="text-3xl font-bold">4</span>
						</div>
					</div>
					<div class="flex-1">
						<h2 class="text-3xl font-bold text-gold mb-4 tracking-tight">FINAL WALKTHROUGH</h2>
						<p class="text-white/70 text-lg mb-6 leading-relaxed">
							We conduct a thorough final inspection with you to ensure every detail meets our high standards and your expectations.
						</p>
						<div class="grid md:grid-cols-2 gap-4">
							<div class="flex items-start gap-3">
								<svg class="w-6 h-6 text-gold mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
									<path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
								</svg>
								<span class="text-white/80">Complete quality inspection</span>
							</div>
							<div class="flex items-start gap-3">
								<svg class="w-6 h-6 text-gold mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
									<path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
								</svg>
								<span class="text-white/80">Touch-ups as needed</span>
							</div>
							<div class="flex items-start gap-3">
								<svg class="w-6 h-6 text-gold mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
									<path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
								</svg>
								<span class="text-white/80">Complete site cleanup</span>
							</div>
							<div class="flex items-start gap-3">
								<svg class="w-6 h-6 text-gold mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
									<path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
								</svg>
								<span class="text-white/80">Warranty and maintenance instructions</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

</Layout>
