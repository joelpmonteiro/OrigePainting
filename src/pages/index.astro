---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home">
	<!-- Hero Section -->
	<section
		class="relative min-h-screen flex items-start justify-center overflow-hidden pt-6.25 md:pt-24 pb-8"
	>
		<!-- Background Image with Overlay -->
		<div class="absolute inset-0 z-0">
			<div
				class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/80 z-10"
			>
			</div>
			<!-- Placeholder for background image - replace with actual image -->
			<div
				class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?q=80&w=2574')] bg-cover bg-center"
			>
			</div>
		</div>

		<!-- Hero Content -->
		<div class="container mx-auto px-4 md:px-6 z-20 text-center">
			<!-- Logo -->
			<div class="mb-4 md:mb-6 animate-fade-in">
				<img
					src="/logo.png"
					alt="Orige Painting Logo"
					class="h-auto w-48 md:w-80 mx-auto object-contain"
				/>
			</div>

			<h1
				class="text-3xl md:text-5xl lg:text-7xl font-bold text-gold mb-4 md:mb-6 animate-fade-in tracking-tight leading-tight"
			>
				TRANSFORMING SPACES WITH<br />
				<span class="text-white">PRECISION & ELEGANCE</span>
			</h1>
			<div class="divider-gold"></div>
			<p
				class="text-base md:text-xl text-white/80 mb-6 md:mb-8 max-w-2xl mx-auto animate-fade-in-delay"
			>
				Experience exceptional painting services that bring your vision to life
				with meticulous attention to detail
			</p>
			<div
				class="flex gap-3 md:gap-4 justify-center flex-wrap animate-fade-in-delay"
			>
				<a href="/contact" class="btn-gold text-sm md:text-base">
					Get Free Estimate
				</a>
				<a href="/portfolio" class="btn-outline-gold text-sm md:text-base">
					View Portfolio
				</a>
			</div>
		</div>

		<!-- Scroll Indicator -->
		<div
			class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20 animate-bounce"
		>
			<svg
				class="w-6 h-6 text-gold"
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
			</svg>
		</div>
	</section>

	<!-- Our Expertise Section -->
	<section class="bg-dark py-24">
		<div class="container mx-auto px-6">
			<div class="text-center mb-16">
				<h2
					class="text-4xl md:text-5xl font-bold text-gold mb-4 tracking-tight"
				>
					OUR EXPERTISE
				</h2>
				<div class="divider-gold"></div>
			</div>

			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
				<!-- Interior Painting -->
				<div class="card-luxury text-center group">
					<div
						class="mb-6 transform group-hover:scale-110 transition-transform duration-300"
					>
						<svg
							class="w-16 h-16 mx-auto text-gold"
							fill="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								d="M19 9.3V4h-3v2.6L12 3L2 12h3v8h5v-6h4v6h5v-8h3l-3-2.7zm-9 .7c0-1.1.9-2 2-2s2 .9 2 2h-4z"
							></path>
						</svg>
					</div>
					<h3 class="text-xl font-bold text-white mb-3 tracking-tight">
						INTERIOR<br />PAINTING
					</h3>
					<p class="text-white/60 text-sm mb-6 leading-relaxed">
						Transform your indoor spaces with premium finishes and impeccable
						attention to detail
					</p>
					<a href="/services#interior" class="btn-outline-gold text-xs"
						>LEARN MORE</a
					>
				</div>

				<!-- Exterior Painting -->
				<div class="card-luxury text-center group">
					<div
						class="mb-6 transform group-hover:scale-110 transition-transform duration-300"
					>
						<svg
							class="w-16 h-16 mx-auto text-gold"
							fill="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								d="M12 3L4 9v12h16V9l-8-6zm0 2.69L18 10v9h-5v-5h-2v5H6v-9l6-4.31z"
							></path>
						</svg>
					</div>
					<h3 class="text-xl font-bold text-white mb-3 tracking-tight">
						EXTERIOR<br />PAINTING
					</h3>
					<p class="text-white/60 text-sm mb-6 leading-relaxed">
						Enhance your property's curb appeal with weather-resistant,
						long-lasting finishes
					</p>
					<a href="/services#exterior" class="btn-outline-gold text-xs"
						>LEARN MORE</a
					>
				</div>

				<!-- Cabinet Refinishing -->
				<div class="card-luxury text-center group">
					<div
						class="mb-6 transform group-hover:scale-110 transition-transform duration-300"
					>
						<svg
							class="w-16 h-16 mx-auto text-gold"
							fill="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								d="M19 2H5c-1.1 0-2 .9-2 2v18h18V4c0-1.1-.9-2-2-2zM9 18H7v-2h2v2zm0-4H7v-2h2v2zm0-4H7V8h2v2zm0-4H7V4h2v2zm4 12h-2v-2h2v2zm0-4h-2v-2h2v2zm0-4h-2V8h2v2zm0-4h-2V4h2v2zm4 12h-2v-2h2v2zm0-4h-2v-2h2v2zm0-4h-2V8h2v2zm0-4h-2V4h2v2z"
							></path>
						</svg>
					</div>
					<h3 class="text-xl font-bold text-white mb-3 tracking-tight">
						CABINET<br />REFINISHING
					</h3>
					<p class="text-white/60 text-sm mb-6 leading-relaxed">
						Breathe new life into your kitchen and bathroom with expert cabinet
						refinishing
					</p>
					<a href="/services#cabinets" class="btn-outline-gold text-xs"
						>LEARN MORE</a
					>
				</div>

				<!-- Power Washing -->
				<div class="card-luxury text-center group">
					<div
						class="mb-6 transform group-hover:scale-110 transition-transform duration-300"
					>
						<svg
							class="w-16 h-16 mx-auto text-gold"
							fill="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								d="M13 3h-2v10h2V3zm4.83 2.17l-1.42 1.42C17.99 7.86 19 9.81 19 12c0 3.87-3.13 7-7 7s-7-3.13-7-7c0-2.19 1.01-4.14 2.58-5.42L6.17 5.17C4.23 6.82 3 9.26 3 12c0 4.97 4.03 9 9 9s9-4.03 9-9c0-2.74-1.23-5.18-3.17-6.83z"
							></path>
						</svg>
					</div>
					<h3 class="text-xl font-bold text-white mb-3 tracking-tight">
						POWER<br />WASHING
					</h3>
					<p class="text-white/60 text-sm mb-6 leading-relaxed">
						Prepare surfaces perfectly and restore beauty with professional
						power washing
					</p>
					<a href="/services#power-washing" class="btn-outline-gold text-xs"
						>LEARN MORE</a
					>
				</div>
			</div>
		</div>
	</section>

	<!-- Our Process Section -->
	<section class="bg-dark-secondary py-24">
		<div class="container mx-auto px-6">
			<div class="text-center mb-16">
				<h2
					class="text-4xl md:text-5xl font-bold text-gold mb-4 tracking-tight"
				>
					OUR PROCESS
				</h2>
				<div class="divider-gold"></div>
				<p class="text-white/70 text-lg mt-6 max-w-2xl mx-auto leading-relaxed">
					A systematic approach ensuring excellence at every stage
				</p>
			</div>

			<div class="max-w-7xl mx-auto">
				<div
					class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8 xl:gap-6"
				>
					<!-- Step 1 -->
					<div class="flex flex-col items-center text-center">
						<div class="icon-circle mb-6">
							<svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24">
								<path
									d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"
								></path>
							</svg>
						</div>
						<h3 class="text-lg font-bold text-white mb-3 tracking-tight">
							1. CONSULTATION<br />& ESTIMATE
						</h3>
						<p class="text-white/60 text-sm leading-relaxed">
							We discuss your vision, assess the project scope, and provide a
							detailed estimate
						</p>
					</div>

					<!-- Step 2 -->
					<div class="flex flex-col items-center text-center">
						<div class="icon-circle mb-6">
							<svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24">
								<path
									d="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm0 4c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm6 12H6v-1.4c0-2 4-3.1 6-3.1s6 1.1 6 3.1V19z"
								></path>
							</svg>
						</div>
						<h3 class="text-lg font-bold text-white mb-3 tracking-tight">
							2. SCHEDULING<br />& PREP
						</h3>
						<p class="text-white/60 text-sm leading-relaxed">
							We schedule at your convenience and thoroughly prepare all
							surfaces for painting
						</p>
					</div>

					<!-- Step 3 -->
					<div class="flex flex-col items-center text-center">
						<div class="icon-circle mb-6">
							<svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24">
								<path
									d="M17.75 7L14 3.25l-10 10V17h3.75l10-10zm2.96-2.96c.39-.39.39-1.02 0-1.41L18.37.29c-.39-.39-1.02-.39-1.41 0L15 2.25 18.75 6l1.96-1.96z"
								></path>
							</svg>
						</div>
						<h3 class="text-lg font-bold text-white mb-3 tracking-tight">
							3. THE WORK
						</h3>
						<p class="text-white/60 text-sm leading-relaxed">
							Expert application with precision, using premium materials and
							proven techniques
						</p>
					</div>

					<!-- Step 4 -->
					<div class="flex flex-col items-center text-center">
						<div class="icon-circle mb-6">
							<svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24">
								<path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"
								></path>
							</svg>
						</div>
						<h3 class="text-lg font-bold text-white mb-3 tracking-tight">
							4. FINAL<br />WALKTHROUGH
						</h3>
						<p class="text-white/60 text-sm leading-relaxed">
							We review the completed work with you, ensuring your complete
							satisfaction
						</p>
					</div>
				</div>
			</div>

			<div class="text-center mt-16">
				<a href="/process" class="btn-gold"> Learn More About Our Process </a>
			</div>
		</div>
	</section>

	<!-- Call to Action -->
	<section class="bg-dark py-24">
		<div class="container mx-auto px-6 text-center">
			<h2
				class="text-4xl md:text-5xl font-bold text-white mb-6 tracking-tight leading-tight"
			>
				Ready to <span class="text-gold">Transform Your Space?</span>
			</h2>
			<p class="text-xl text-white/70 mb-10 max-w-2xl mx-auto">
				Get a free, no-obligation estimate and discover how we can bring your
				vision to life
			</p>
			<div class="flex gap-4 justify-center flex-wrap">
				<a href="/contact" class="btn-gold"> Get Free Estimate </a>
				<a href="tel:+18001234567" class="btn-outline-gold">
					Call +1 (508) 901-7609
				</a>
			</div>
		</div>
	</section>
</Layout>
