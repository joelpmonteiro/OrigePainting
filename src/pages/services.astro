	<!-- Power Washing Gallery Modal -->
	<div id="powerWashingGallery" class="fixed inset-0 bg-black/95 z-50 hidden items-center justify-center p-4">
		<button onclick="closePowerWashingGallery()" class="absolute top-4 right-4 text-white text-4xl hover:text-gold transition-colors z-10">
			&times;
		</button>
		<div class="max-w-6xl w-full">
			<div class="grid grid-cols-1 gap-4">
				<img src="/img/power-wahsing.jpeg" alt="Power Washing Gallery 1" class="w-full h-auto max-h-[80vh] object-contain rounded-lg" />
			</div>
			<div class="text-center mt-6">
				<p class="text-white/80 text-lg">Power Washing Services</p>
				<p class="text-white/60 text-sm mt-2">Professional deck cleaning and restoration</p>
			</div>
		</div>
	</div>

	<script>
		function openPowerWashingGallery() {
			const gallery = document.getElementById('powerWashingGallery');
			if (gallery) {
				gallery.classList.remove('hidden');
				gallery.classList.add('flex');
				document.body.style.overflow = 'hidden';
			}
		}

		function closePowerWashingGallery() {
			const gallery = document.getElementById('powerWashingGallery');
			if (gallery) {
				gallery.classList.add('hidden');
				gallery.classList.remove('flex');
				document.body.style.overflow = 'auto';
			}
		}

		// Close gallery on ESC key
		document.addEventListener('keydown', function(e) {
			if (e.key === 'Escape') {
				closePowerWashingGallery();
			}
		});

		// Close gallery on click outside
		document.getElementById('powerWashingGallery')?.addEventListener('click', function(e) {
			if (e.target === this) {
				closePowerWashingGallery();
			}
		});
	</script>
