<Layout title="Services" description="Professional painting services for residential and commercial properties">
	<!-- Hero Section -->
	<section class="bg-dark-secondary py-12 text-center border-b border-white/10">
		<div class="container mx-auto px-6">
			<h1 class="text-5xl md:text-6xl font-bold text-gold mb-4 tracking-tight">OUR SERVICES</h1>
			<div class="divider-gold"></div>
			<p class="text-xl text-white/70 mt-6 max-w-2xl mx-auto">
				Comprehensive painting solutions tailored to your needs
			</p>
		</div>
	</section>

	<!-- Interior Painting -->
