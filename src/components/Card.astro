---
interface Props {
	title?: string;
	icon?: string;
	class?: string;
}

const { title, icon, class: className = '' } = Astro.props;
---

<div class={`bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow duration-300 ${className}`}>
	{icon && (
		<div class="text-4xl mb-4">{icon}</div>
	)}
	{title && (
		<h3 class="text-xl font-bold mb-4 text-gray-900">{title}</h3>
	)}
	<div class="text-gray-600">
		<slot />
	</div>
</div>
