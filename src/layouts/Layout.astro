---
import "../styles/global.css";
import Footer from "../components/Footer.astro";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Transforming spaces with precision & elegance" } =
	Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Orige Painting</title>
	</head>
	<body class="bg-dark text-white min-h-screen flex flex-col">
		<!-- Header -->
		<header
			class="fixed w-full top-0 z-50 bg-dark/95 backdrop-blur-sm border-b border-white/10"
		>
			<nav
				class="container mx-auto px-6 py-4 flex justify-between items-center"
			>
				<!-- Logo -->
				<a href="/" class="flex items-center gap-3 group">
					<img
						src="/logo.png"
						alt="Orige Painting Logo"
						class="h-12 lg:h-16 w-auto object-contain"
					/>
				</a>

				<!-- Desktop Menu -->
				<ul class="hidden lg:flex items-center gap-8">
					<li>
						<a
							href="/"
							class={`text-white/90 hover:text-gold transition-colors ${currentPath === "/" ? "text-gold" : ""}`}
						>
							Home
						</a>
					</li>
					<li>
						<a
							href="/services"
							class={`text-white/90 hover:text-gold transition-colors ${currentPath === "/services" ? "text-gold" : ""}`}
						>
							Services
						</a>
					</li>
					<li>
						<a
							href="/process"
							class={`text-white/90 hover:text-gold transition-colors ${currentPath === "/process" ? "text-gold" : ""}`}
						>
							Our Process
						</a>
					</li>
					<li>
						<a
							href="/portfolio"
							class={`text-white/90 hover:text-gold transition-colors ${currentPath === "/portfolio" ? "text-gold" : ""}`}
						>
							Portfolio
						</a>
					</li>
					<li>
						<a
							href="/contact"
							class={`text-white/90 hover:text-gold transition-colors ${currentPath === "/contact" ? "text-gold" : ""}`}
						>
							Contact
						</a>
					</li>
					<li
						class="flex items-center gap-3 border-l border-white/10 pl-6"
					>
						<a
							href="https://www.instagram.com/orige.painting.inc"
							target="_blank"
							rel="noopener noreferrer"
							class="text-white/70 hover:text-gold transition-colors"
							title="Follow us on Instagram"
						>
							<svg
								class="w-5 h-5"
								fill="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
								></path>
							</svg>
						</a>
						<a
							href="https://www.facebook.com/OrigeGeneralPaintingInc/"
							target="_blank"
							rel="noopener noreferrer"
							class="text-white/70 hover:text-gold transition-colors"
							title="Follow us on Facebook"
						>
							<svg
								class="w-5 h-5"
								fill="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
								></path>
							</svg>
						</a>
					</li>
					<li>
						<a href="/contact" class="btn-gold inline-block">
							Get A Free Estimate
						</a>
					</li>
				</ul>

				<!-- Mobile Social Icons and Menu Button -->
				<div class="lg:hidden flex items-center gap-4">
					<a
						href="https://www.instagram.com/orige.painting.inc"
						target="_blank"
						rel="noopener noreferrer"
						class="text-white/70 hover:text-gold transition-colors"
						title="Follow us on Instagram"
					>
						<svg
							class="w-5 h-5"
							fill="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
							></path>
						</svg>
					</a>
					<a
						href="https://www.facebook.com/OrigeGeneralPaintingInc/"
						target="_blank"
						rel="noopener noreferrer"
						class="text-white/70 hover:text-gold transition-colors"
						title="Follow us on Facebook"
					>
						<svg
							class="w-5 h-5"
							fill="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
							></path>
						</svg>
					</a>
					<button id="mobile-menu-btn" class="text-gold">
						<svg
							class="w-7 h-7"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M4 6h16M4 12h16M4 18h16"></path>
						</svg>
					</button>
				</div>
			</nav>

			<!-- Mobile Menu -->
			<div
				id="mobile-menu"
				class="hidden lg:hidden bg-dark-secondary border-t border-white/10"
			>
				<ul class="container mx-auto px-6 py-6 flex flex-col gap-4">
					<li>
						<a
							href="/"
							class="block py-2 text-white/90 hover:text-gold transition-colors"
						>
							Home
						</a>
					</li>
					<li>
						<a
							href="/services"
							class="block py-2 text-white/90 hover:text-gold transition-colors"
						>
							Services
						</a>
					</li>
					<li>
						<a
							href="/process"
							class="block py-2 text-white/90 hover:text-gold transition-colors"
						>
							Our Process
						</a>
					</li>
					<li>
						<a
							href="/portfolio"
							class="block py-2 text-white/90 hover:text-gold transition-colors"
						>
							Portfolio
						</a>
					</li>
					<li>
						<a
							href="/contact"
							class="block py-2 text-white/90 hover:text-gold transition-colors"
						>
							Contact
						</a>
					</li>
					<li>
						<a
							href="/contact"
							class="btn-gold inline-block text-center w-full mt-2"
						>
							Get A Free Estimate
						</a>
					</li>
				</ul>
			</div>
		</header>

		<!-- Spacer for fixed header -->
		<div class="h-20"></div>

		<!-- Main Content -->
		<main class="grow">
			<slot />
		</main>

		<!-- Footer -->
		<Footer />

		<!-- Mobile Menu Script -->
		<script>
			const btn = document.getElementById("mobile-menu-btn");
			const menu = document.getElementById("mobile-menu");

			btn?.addEventListener("click", () => {
				menu?.classList.toggle("hidden");
			});

			// Close mobile menu when clicking outside
			document.addEventListener("click", (e) => {
				const target = e.target as HTMLElement;
				if (!btn?.contains(target) && !menu?.contains(target)) {
					menu?.classList.add("hidden");
				}
			});

			// Close mobile menu when resizing to desktop
			window.addEventListener("resize", () => {
				if (window.innerWidth >= 1024) {
					menu?.classList.add("hidden");
				}
			});
		</script>
	</body>
</html>
